# TianshangChat server configuration
# Copy to .env and adjust. NEVER commit your real .env.

PORT=3000
NODE_ENV=development

# REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# SQLite database file (relative to apps/server or absolute)
DATABASE_PATH=./data/chat.db

# Upload directory served at /uploads (relative to apps/server or absolute)
UPLOAD_DIR=./uploads
