{
  "name": "tianshangchat",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "TianshangChat - real-time chat with E2EE, offline-first, plugin-ready (monorepo)",
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter @tianshangchat/server db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^2.1.9"
  }
}
